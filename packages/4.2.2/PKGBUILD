pkgname=forge-lab
pkgver=4.2.2
pkgrel=5
pkgdesc='Verified KVM lab with GNOME Boxes and online music'
arch=('x86_64')
url='https://github.com/gogu-glogowski/Forge-v4'
license=('Apache-2.0' 'CC-BY-4.0')
depends=('glibc>=2.39' 'gcc-libs' 'qemu-desktop' 'qemu-img' 'libvirt' 'gnome-boxes'
         'apparmor' 'gnupg' 'curl' 'ca-certificates' '7zip' 'tar' 'xz' 'e2fsprogs'
         'networkmanager' 'iproute2' 'procps-ng' 'psmisc' 'systemd' 'sudo'
         'coreutils' 'util-linux' 'python' 'dnsmasq' 'nftables' 'iptables')
makedepends=('rust>=1.89' 'cargo')
optdepends=('mpv: online background music during prepare --all')
# GCC LTO objects in ring cannot be consumed by Rust's lld linker.
options=('!strip' '!debug' '!lto')
source=("forge-${pkgver}-source.tar.gz")
sha256sums=('5651031d5cf1f98aae11a29fefa3c1445f37ac5fec3af1f4b323ac9bf8d8a3a7')

build() {
  cd "forge-${pkgver}"
  # Produce a baseline x86_64 package even on CachyOS with native CPU defaults.
  export CFLAGS="${CFLAGS:-} -march=x86-64 -mtune=generic"
  export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=x86-64"
  local offline=()
  [[ ${FORGE_CARGO_OFFLINE:-0} == 1 ]] && offline=(--offline)
  cargo build --release --locked -p forge-cli "${offline[@]}"
}

package() {
  cd "forge-${pkgver}"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/forge" "${pkgdir}/usr/bin/forge"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 CHANGELOG.md "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
  install -Dm644 packaging/arch/README.md "${pkgdir}/usr/share/doc/${pkgname}/README.Arch.md"
  install -Dm755 packaging/arch/forge-install "${pkgdir}/usr/bin/forge-install"
  install -Dm644 "../forge-${pkgver}-source.tar.gz" "${pkgdir}/usr/share/forge/installer-source.tar.gz"
  install -Dm644 packaging/arch/install/README.PL.md "${pkgdir}/usr/share/doc/${pkgname}/INSTALL.PL.md"
  local item
  for item in CREDITS.md LICENSE-CC-BY-4.0.txt manifest.json; do
    install -Dm644 "assets/music/${item}" "${pkgdir}/usr/share/forge/music/${item}"
  done
}
